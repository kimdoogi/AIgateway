{
  "name": "ai-gateway",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.17"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json && cp src/server/console.html src/server/portal.html src/server/docs.html src/server/landing.html dist/server/",
    "start": "node dist/server/index.js",
    "migrate": "tsx tools/migrate.ts",
    "capture": "tsx tools/capture/capture.ts",
    "smoke:roadmap4": "tsx tools/smoke-roadmap4.ts",
    "smoke:xai": "tsx tools/smoke-xai.ts",
    "smoke:gemini": "tsx tools/smoke-gemini.ts",
    "smoke:appendix-b": "tsx tools/smoke-appendix-b.ts",
    "smoke:batches": "tsx tools/smoke-batches.ts",
    "dev": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "hono": "^4",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3"
  }
}
