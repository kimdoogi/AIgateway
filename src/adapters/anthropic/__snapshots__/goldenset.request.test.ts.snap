exports[`골든셋 ① IR → anthropic wire > tools — function 툴 + 지정 toolChoice + 병렬 off 1`] = `
{
  "request": {
    "body": {
      "max_tokens": 200,
      "messages": [
        {
          "content": [
            {
              "text": "weather?",
              "type": "text",
            },
          ],
          "role": "user",
        },
      ],
      "model": "claude-haiku-4-5",
