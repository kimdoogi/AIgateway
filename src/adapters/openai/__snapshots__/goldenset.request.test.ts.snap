exports[`골든셋 ① IR → openai chat-completions wire > cc-tools — function 툴 + toolChoice + 툴콜 왕복 1`] = `
{
  "request": {
    "body": {
      "messages": [
        {
          "content": [
            {
              "text": "weather?",
              "type": "text",
            },
          ],
          "role": "user",
        },
        {
          "role": "assistant",
          "tool_calls": [
            {
              "function": {
                "arguments": "{"city":"Paris"}",
                "name": "get_weather",
              },
              "id": "call_f1",
              "type": "function",
            },
          ],
        },
        {
          "content": "21C",
          "role": "tool",
          "tool_call_id": "call_f1",
        },
      ],
      "model": "gpt-5.6-luna",
      "tool_choice": "auto",
      "tools": [
        {
          "function": {
            "description": "Get weather.",
            "name": "get_weather",
            "parameters": {
              "additionalProperties": false,
              "properties": {
                "city": {
                  "type": "string",
                },
              },
              "required": [
                "city",
              ],
              "type": "object",
            },
            "strict": true,
          },
          "type": "function",
        },
      ],
    },
    "headers": {
      "content-type": "application/json",
    },
    "method": "POST",
    "path": "/v1/chat/completions",
  },
  "warnings": [],
}
`;

