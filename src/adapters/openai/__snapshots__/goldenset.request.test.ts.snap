exports[`골든셋 ① IR → openai responses wire > po-full — 서버상태 opt-in(override warning)·reasoning 옵션·serviceTier 1`] = `
{
  "request": {
    "body": {
      "input": [
        {
          "content": [
            {
              "text": "hi",
              "type": "input_text",
            },
          ],
          "role": "user",
          "type": "message",
        },
      ],
      "model": "gpt-5.6-luna",
      "previous_response_id": "resp_fixture0001",
      "prompt_cache_key": "tenant-1",
      "reasoning": {
        "context": "all_turns",
        "effort": "high",
        "summary": "auto",
      },
      "service_tier": "flex",
      "store": true,
      "text": {
        "verbosity": "low",
      },
    },
    "headers": {
      "content-type": "application/json",
    },
    "method": "POST",
    "path": "/v1/responses",
  },
  "warnings": [
    {
      "code": "provider-option-override",
      "message": "providerOptions.openai.store가 표준 필드의 wire 슬롯 'store'을 덮어씀 (게이트웨이 기본 store:false를 opt-in으로 해제)",
      "path": "store",
      "type": "compatibility",
    },
    {
      "code": "server-state-unmanaged",
      "message": "store:true — 서버측 상태는 게이트웨이 관리 밖 (리소스 레지스트리는 로드맵 5)",
      "type": "other",
    },
    {
      "code": "server-state-unmanaged",
      "message": "previous_response_id passthrough — 서버측 상태 참조",
      "type": "other",
    },
  ],
}
`;

