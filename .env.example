# .env로 복사 후 값 채우기. .env는 커밋되지 않는다.
ANTHROPIC_API_KEY=
DATABASE_URL=postgres://gateway:gateway@localhost:5433/gateway
REDIS_URL=redis://localhost:6380

# ── 운영 (프로덕션 배포 — 2026-08-22) ────────────────────────────
# 상태 계층: 미설정 시 인메모리 폴백 (단일 레플리카 전용)
# DATABASE_URL=postgres://gateway:gateway@localhost:5433/gateway
# REDIS_URL=redis://localhost:6380
#   ↑ REDIS_URL이 있어야 예산 집계·레이트리밋·취소 전파가 레플리카 간 공유된다.
#     없으면 프로세스 로컬 — 다중 레플리카에서 hard 예산이 레플리카 수만큼 곱해진다.

# GATEWAY_ADMIN_KEY=          # 설정 시 가상 키 인증·관리 API 활성 (미설정 = 개방 모드)
# GATEWAY_KEY_ENCRYPTION_KEY= # BYO 프로바이더 키 AES-256-GCM 마스터 키 (32바이트 hex/base64)
# GATEWAY_VERSION=            # /health 응답·트레이스에 실릴 빌드 식별자

# PORT=8787
# PGPOOL_MAX=10               # 프로세스당 pg 커넥션 상한 (레플리카 수 × 이 값 < max_connections)
# MIGRATE_ON_BOOT=true        # false면 앱이 스키마를 바꾸지 않고 **미적용/드리프트 검사만** 한다.
#   오케스트레이터 권장 구성: MIGRATE_ON_BOOT=false + 배포 전 `pnpm migrate`를 Job/initContainer로.
#   마이그레이션 주체를 하나로 두어 여러 파드가 동시에 스키마를 바꾸지 않게 한다.
#   스키마가 뒤처진 파드는 /ready가 503이라 LB가 붙이지 않는다.
# UPSTREAM_TIMEOUT_MS=120000  # 업스트림 접속 타임아웃 (본문 스트리밍에는 미적용)
# MAX_JSON_BODY_BYTES=10485760
# MAX_UPLOAD_BYTES=67108864
# BODY_LOG_RETENTION_DAYS=0   # >0이면 관리 스윕이 초과분 삭제 (0 = 무기한 보관)
# SPEND_RETENTION_DAYS=31     # Redis 지출 버킷 보관 (최장 예산 창보다 커야 한다)

# graceful shutdown — 오케스트레이터의 terminationGracePeriod가 HARD_EXIT보다 커야 한다
# SHUTDOWN_DRAIN_DELAY_MS=5000     # /ready 503 후 LB 이탈 대기
# SHUTDOWN_DRAIN_TIMEOUT_MS=25000  # 진행 중 스트림 완주 상한
# SHUTDOWN_HARD_EXIT_MS=40000

# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318  # 미설정이면 트레이싱 비활성(span no-op)
# OTEL_SERVICE_NAME=ai-gateway

# ── 셀프 가입 포털 (2026-08-24) — 인증 모드(GATEWAY_ADMIN_KEY)에서 /portal 활성 ──
# PORTAL_INVITE_CODE=         # 설정 시 가입에 초대 코드 요구 — 인터넷 노출 배포 권장
# PORTAL_KEY_RPM=60           # 포털 발급 키의 분당 한도 (계정이 못 올림 — 상향은 관리자)
# PORTAL_KEY_HARD_USD=5       # 기간 예산 hard (차단)
# PORTAL_KEY_SOFT_USD=4       # soft (경고) — 미설정 시 hard의 80%
# PORTAL_KEY_PERIOD_DAYS=30
# PORTAL_MAX_KEYS=5           # 계정당 활성 키 수
# PORTAL_SESSION_TTL_DAYS=7
